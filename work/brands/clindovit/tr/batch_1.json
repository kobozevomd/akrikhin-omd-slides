 },
 {
  "slide": 6,
  "ru": "россиян хотя бы раз за последний год использовали ИИ для предварительного определения диагноза или поиска подходящего лекарства.",
  "id": "s0251"
 },
 {
  "slide": 6,
  "ru": "«Хочу результат быстрее»",
  "id": "s0252"
 },
 {
  "slide": 6,
  "ru": "«Хочу лечить, но боюсь испортить кожу»",
